{{!
    @template local_ragassistant/configuration_health

    Configuration health check panel on the plugin settings page. One row per test;
    the local_ragassistant/configuration_health module updates the icon, badge and message.

    Classes required for JS:
    * none; the module finds rows by the data-test and data-role attributes.

    Data attributes required for JS:
    * data-test - the test key, on each list item
    * data-description - the idle text, restored when a test has no message
    * data-role - icon, message or badge, inside each list item

    Context variables required for this template:
    * buttonlabel - Text of the run button
    * idlelabel - Badge text before a test has run
    * tests - The tests to list, each with key, label and description

    Example context (json):
    {
        "buttonlabel": "Run Configuration Tests",
        "idlelabel": "Not tested",
        "tests": [
            {"key": "server", "label": "Backend server", "description": "Moodle can reach the FastAPI backend."},
            {"key": "llm", "label": "Main chat model", "description": "The selected provider and model answer a test request."}
        ]
    }
}}
<div class="local-ragassistant-healthcheck" id="ragassistant-healthcheck">
    <button type="button" id="ragassistant-run-healthcheck" class="btn btn-primary">{{buttonlabel}}</button>
    <ul class="list-group mt-3">
        {{#tests}}
        <li class="list-group-item d-flex align-items-start" data-test="{{key}}" data-description="{{description}}" data-status="idle">
            <span class="fa-regular fa-circle fs-4 text-muted me-3 mt-1" data-role="icon" aria-hidden="true"></span>
            <div class="flex-grow-1">
                <div class="fw-bold">{{label}}</div>
                <div class="small text-muted" data-role="message">{{description}}</div>
            </div>
            <span class="badge text-bg-light border ms-3" data-role="badge">{{idlelabel}}</span>
        </li>
        {{/tests}}
    </ul>
    <div id="ragassistant-healthcheck-summary" class="mt-3 fw-bold" role="status" aria-live="polite"></div>
</div>
